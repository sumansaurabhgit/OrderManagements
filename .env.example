# Copy to .env.local and fill in. Never commit real values (.env* is gitignored).
#
# Local development with the Docker stack: `npx supabase start` prints the
# Supabase values (or run `npx supabase status -o env`). If you keep hosted
# keys in .env.local, put the local Supabase values in .env.development.local
# instead — `next dev` gives that file precedence.

# Public base URL of the app (no trailing slash). Used for Stripe redirect URLs
# and auth email links. Production: https://<your-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — the anon (publishable) key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER ONLY. Bypasses RLS; used solely by the Stripe webhook and to store
# server-created Checkout Sessions. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe (test mode). SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_replace_me
# Local: printed by `npm run stripe:listen` (or `stripe listen --print-secret`).
# Production: the signing secret of the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. Not required by hosted Stripe Checkout (the server redirects to the
# session URL); only needed if Stripe.js / Elements are added later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
